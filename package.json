{
  "name": "latex-modeler",
  "private": true,
  "version": "0.1.0",
  "description": "3D LaTeX page designer with an automatic equation modeller",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "dev": "npm run vendor && npm run build:player && vite",
    "build": "npm run vendor && npm run build:player && vite build",
    "preview": "vite preview",
    "test": "tsx tests/run.ts",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "build:player": "vite build --config vite.player.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.1",
    "gifenc": "^1.0.3",
    "mathjax": "3.2.2",
    "mp4-muxer": "^5.2.2",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.20.5",
    "@types/three": "0.160.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "license": "UNLICENSED"
}
