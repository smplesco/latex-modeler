// Your first page — the building blocks (text, shapes, a graph, real 3D) explained line by line.
// Change any number and watch the page redraw. Click something on the page to jump to its line.
page("A5", "paper")
duration(4)

// 1. Text. tex() typesets LaTeX at a point in mm, measured from the bottom-left corner.
tex("\textbf{My first page}", (74, 197), {size: 18})
tex("\text{everything on this page is drawn by the code on the left}", (74, 189), {size: 8.5, color: "#777"})
line((14, 183), (134, 183), {width: 0.3})

// 2. Shapes. Options go in { braces }: color, width, fill, opacity, dash …
circle((28, 164), 9, {color: "#d64545", width: 0.5})
rect((50, 155), (18, 18), {fill: "#5b9bd5", opacity: 0.35, stroke: "#2b6cb0", width: 0.4})
arrow((80, 164), (102, 164), {width: 0.5})
dot((118, 164), {r: 1.8, color: "#2e9e6a"})
for i in 0..4 { text(["circle", "rect", "arrow", "dot"][i], ([28, 59, 91, 118][i], 149), {size: 8, color: "#555"}) }

// 3. A graph. frame2d() sets up axes; fplot() draws y = f(x) inside them.
// k changes with time t: press play (or drag the timeline) to see it move.
k = 1 + 0.5 * sin(2 * pi * t / 4)
G = frame2d((18, 92), (112, 42), (-pi, pi), (-1.3, 1.3), {piTicks: true})
fplot(G, x => sin(x), {color: "#999", width: 0.35})
fplot(G, x => sin(k * x), {color: "#d64545", width: 0.5})
tex("y = \sin(" + fmt(k, 2) + "\,x)", G.map((1.9, 1.05)), {size: 9, color: "#d64545"})

// 4. Real 3D. frame3d() is a textbook box; splot() draws z = f(x, y).
// Drag the viewer to orbit: the surface rises off the paper.
B = frame3d((74, 44), 54, (-2, 2), (-2, 2), (-1, 1))
splot(B, (x, y) => exp(-(x^2 + y^2) / 1.5) * cos(k * 2 * x), {n: 56})
