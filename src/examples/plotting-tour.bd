// plotting-tour.bd — the plotting library in one page.
// Every call below is what the LaTeX auto-modeller writes for you; mix them freely.
page("A4", "paper")
duration(6)
tex("\textbf{A tour of the plotting library}", (105, 281), {size: 19})
line((20, 273), (190, 273), {width: 0.3})

// 1 — graphs with π ticks: frame2d + fplot
A = frame2d((28, 200), (70, 55), (-2 * pi, 2 * pi), (-1.5, 1.5), {piTicks: true})
fplot(A, x => sin(x), {width: 0.45})
fplot(A, x => cos(x), {color: "#e08a1e", width: 0.45})
tex("\text{fplot}", (63, 262), {size: 10})

// 2 — implicit curves and regions: cplot + region
B = frame2d((118, 200), (70, 55), (-2.5, 2.5), (-2, 2), {equal: true})
region(B, (x, y) => x^2 / 4 + y^2 < 1, {fill: "#5b9bd5", opacity: 0.3})
cplot(B, (x, y) => x^2 / 4 + y^2 - 1, {width: 0.45})
cplot(B, (x, y) => y - x^3 + x, {color: "#d64545", width: 0.45})
tex("\text{cplot + region}", (153, 262), {size: 10})

// 3 — differential equations: slopefield + solcurve
C = frame2d((28, 118), (70, 55), (-3, 3), (-3, 3))
g(x, y) = x - y
slopefield(C, g, {n: 17})
for k in range(-2, 3) { solcurve(C, g, (0, k), {color: hsl(200 + 30 * k, 70, 45)}) }
tex("\text{slopefield + solcurve}", (63, 180), {size: 10})

// 4 — vector fields: streamlines + quiver
D = frame2d((118, 118), (70, 55), (-2, 2), (-2, 2), {equal: true})
v(x, y) = (-y + 0.3 * x, x)
streamlines(D, v, {n: 7})
quiver(D, v, {n: 13})
tex("\text{streamlines + quiver}", (153, 180), {size: 10})

// 5 — 3D: an implicit surface and a space curve in one frame
E = frame3d((105, 62), 70, (-1.6, 1.6), (-1.6, 1.6), (-1.6, 1.6), {equal: true})
isoplot(E, (x, y, z) => x^4 + y^4 + z^4 - 1, {n: 34, opacity: 0.9})
pplot(E, s => (1.4 * cos(s), 1.4 * sin(s), 0.25 * sin(4 * s + 2 * pi * t / 6)), (0, 2 * pi), {color: "#d64545", width: 0.6})
tex("\text{isoplot + pplot (orbit me)}", (105, 18), {size: 10})
