{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LaTeX Modeler",
  "version": "0.1.0",
  "identifier": "io.smplesco.latexmodeler",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LaTeX Modeler",
        "width": 1440,
        "height": 920,
        "minWidth": 820,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "smplesco",
    "category": "Education",
    "shortDescription": "3D LaTeX pages and an automatic equation modeller",
    "longDescription": "LaTeX Modeler is a scriptable page designer: LaTeX typeset as real 3D geometry, textbook-style 3D figures you can orbit, and an auto-modeller that turns any equation into an editable, annotated page.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "bd"
        ],
        "name": "LaTeX Modeler page",
        "description": "LaTeX Modeler page script",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "screenboard"
        ],
        "name": "Screenboard board",
        "description": "Boards for LaTeX Modeler's board mode",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "copyright": "© 2026 smplesco. All rights reserved."
  }
}
